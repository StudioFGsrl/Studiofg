{
  "name": "profis-mcp",
  "version": "0.1.0",
  "description": "Server MCP che collega Claude a PROFIS (Sistemi) in cloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test --test-timeout=30000 test/*.test.mjs",
    "test:worker": "node --test --test-timeout=120000 test/worker.test.mjs",
    "deploy:cloudflare": "wrangler deploy"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "wrangler": "^4.151.3"
  },
  "type": "module",
  "bin": {
    "profis-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "private": true
}
