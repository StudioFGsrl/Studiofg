# --- PROFIS su SISTEMINRETE ---
PROFIS_BASE_URL=https://serviziprofis.sisteminrete.com
# Identificativo applicazione/installazione che compare negli URL come App-{AppId} (chiedilo a Sistemi)
PROFIS_APP_ID=

# Login: il server chiama /auth/App-{AppId}/Token e rinnova il token quando scade.
# La password viene cifrata SHA256 automaticamente; in alternativa indica direttamente l'hash.
PROFIS_USER=
PROFIS_PASSWORD=
# PROFIS_PASSWORD_SHA256=

# In alternativa al login: token già ottenuto (non viene rinnovato)
# PROFIS_TOKEN=

# Gruppo su cui lavorare, se previsto (header X-BC-Gruppo / X-BC-GruppoPwd)
# PROFIS_GRUPPO=
# PROFIS_GRUPPO_PWD=
# PROFIS_GRUPPO_PWD_SHA256=

# File scaricati: se impostata, i file vengono salvati in questa cartella invece di essere passati a Claude
# PROFIS_DOWNLOAD_DIR=C:\Users\nome\Documents\profis-download
# PROFIS_MAX_FILE_BYTES=10485760

# PROFIS_TIMEOUT_MS=60000
# PROFIS_MAX_RESPONSE_CHARS=100000

# --- Pubblicazione sul dominio (docker-compose.yml) ---
# Sottodominio che punta al server, es. mcp.studiofgsrl.it
# MCP_DOMAIN=

# --- Trasporto MCP ---
# stdio = Claude Desktop / Claude Code sul PC; http = connettore personalizzato su claude.ai
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# Obbligatorio in http: almeno 32 caratteri casuali (lettere, cifre, - e _).
# Si genera ad esempio con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Claude lo invia come "Authorization: Bearer ..." oppure nell'URL: https://mcp.tuodominio.it/mcp/<token>
# MCP_AUTH_TOKEN=
# Hostname pubblici ammessi se il server è dietro un dominio (protezione DNS rebinding)
# MCP_ALLOWED_HOSTS=mcp.studiofgsrl.it
