# --- PROFIS (Sistemi) in cloud ---
# URL base delle API REST fornito da Sistemi / dal rivenditore
PROFIS_BASE_URL=https://serviziprofis.sisteminrete.com

# Autenticazione: bearer | apikey | basic | oauth_client_credentials
PROFIS_AUTH_MODE=apikey
# PROFIS_TOKEN=

# apikey (metodo usato da SISTEMINRETE)
# Header indicato nello Swagger di SISTEMINRETE
PROFIS_API_KEY_HEADER=X-BC-GruppoPwd
PROFIS_API_KEY=

# basic
# PROFIS_USERNAME=
# PROFIS_PASSWORD=

# oauth_client_credentials
# PROFIS_OAUTH_TOKEN_URL=
# PROFIS_OAUTH_CLIENT_ID=
# PROFIS_OAUTH_CLIENT_SECRET=
# PROFIS_OAUTH_SCOPE=

# Header aggiuntivi richiesti da PROFIS (es. codice studio/installazione), JSON
# PROFIS_EXTRA_HEADERS={"X-Codice-Studio":"12345"}

# Percorsi degli endpoint: i default sono ipotesi, vanno verificati con la documentazione Sistemi
# PROFIS_EP_DOCUMENTI_CERCA=/GestioneDocumentale/Documenti/Ricerca
# PROFIS_EP_DOCUMENTO_LEGGI=/GestioneDocumentale/Documenti/LeggiDaGuid
# PROFIS_EP_DOCUMENTO_CRONOLOGIA=/GestioneDocumentale/Documenti/Cronologia
# PROFIS_EP_ALLEGATI_CERCA=/GestioneDocumentale/Allegati/LeggiElenco
# PROFIS_EP_ALLEGATO_LEGGI=/GestioneDocumentale/Allegati/Leggi
# PROFIS_EP_ANNOTAZIONI_CERCA=/GestioneDocumentale/Annotazioni/LeggiElenco
# PROFIS_EP_ANNOTAZIONE_LEGGI=/GestioneDocumentale/Annotazioni/Leggi

# PROFIS_TIMEOUT_MS=30000
# PROFIS_MAX_RESPONSE_CHARS=100000

# --- Trasporto MCP ---
# stdio = Claude Desktop / Claude Code sul PC; http = connettore personalizzato su claude.ai
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# Obbligatorio in http: token che Claude deve inviare come "Authorization: Bearer ..."
# MCP_AUTH_TOKEN=
# Hostname pubblici ammessi se il server è dietro un dominio (protezione DNS rebinding)
# MCP_ALLOWED_HOSTS=mcp.studiofg.it
